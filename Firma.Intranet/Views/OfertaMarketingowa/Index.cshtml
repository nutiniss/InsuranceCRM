@model IEnumerable<Firma.Data.Data.Ubezpieczenia.OfertaMarketingowa>

@{
    ViewData["Title"] = "Oferty marketingowe";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Portal CRM</p>
        <h1>Oferty marketingowe</h1>
        <p class="crm-muted mb-0">Przegląd aktywnych rekordów i szybkie akcje operacyjne.</p>
    </div>
    <a asp-action="Create" class="btn btn-success crm-primary-action"><i class="bi bi-plus-circle"></i> Dodaj</a>
</div>
<div class="crm-table-card">
    <div class="table-responsive">
<table class="table crm-table align-middle mb-0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tytul)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tresc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GrupaDocelowa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataUtworzenia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataPublikacji)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataWaznosci)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CzyAktywna)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Uzytkownik)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Tytul)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tresc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GrupaDocelowa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataUtworzenia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataPublikacji)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataWaznosci)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CzyAktywna)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Uzytkownik.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdOfertyMarketingowej">Edytuj</a>
                <a asp-action="Details" asp-route-id="@item.IdOfertyMarketingowej">Szczegóły</a>
                <a asp-action="Delete" asp-route-id="@item.IdOfertyMarketingowej">Archiwizuj</a>
            </td>
        </tr>
}
    </tbody>
</table>
    </div>
</div>

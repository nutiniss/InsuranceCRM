@model Firma.Data.Data.Ubezpieczenia.Oferta

@{
    ViewData["Title"] = "Edytuj: Oferta";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Oferty</p>
        <h1>Edytuj: Oferta</h1>
        <p class="crm-muted mb-0">Zaktualizuj dane rekordu i zapisz zmiany w systemie.</p>
    </div>
</div>
<div class="crm-form-card">
<div class="row g-3">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdOferty" />
            <div class="mb-3">
                <label asp-for="NumerOferty" class="control-label"></label>
                <input asp-for="NumerOferty" class="form-control" />
                <span asp-validation-for="NumerOferty" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataUtworzenia" class="control-label"></label>
                <input asp-for="DataUtworzenia" class="form-control" />
                <span asp-validation-for="DataUtworzenia" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataWaznosci" class="control-label"></label>
                <input asp-for="DataWaznosci" class="form-control" />
                <span asp-validation-for="DataWaznosci" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="ViewBag.StatusyOferty">
                    <option value="">-- wybierz status oferty --</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Przypis" class="control-label"></label>
                <input asp-for="Przypis" class="form-control" />
                <span asp-validation-for="Przypis" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IdKlienta" class="control-label"></label>
                <select asp-for="IdKlienta" class="form-control" asp-items="ViewBag.IdKlienta"></select>
                <span asp-validation-for="IdKlienta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IdUzytkownika" class="control-label"></label>
                <select asp-for="IdUzytkownika" class="form-control" asp-items="ViewBag.IdUzytkownika"></select>
                <span asp-validation-for="IdUzytkownika" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IdProduktuUbezpieczeniowego" class="control-label"></label>
                <select asp-for="IdProduktuUbezpieczeniowego" class="form-control" asp-items="ViewBag.IdProduktuUbezpieczeniowego"></select>
                <span asp-validation-for="IdProduktuUbezpieczeniowego" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <input type="submit" value="Zapisz zmiany" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataWaznosci)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataWaznosci)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Przypis)
        </dt>
        <dd class = "col-sm-10">

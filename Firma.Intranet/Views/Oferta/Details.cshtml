            @Html.DisplayNameFor(model => model.NumerOferty)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumerOferty)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataUtworzenia)
        </dt>
        <dd class = "col-sm-10">

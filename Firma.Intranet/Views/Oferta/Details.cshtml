<div class="d-flex gap-2 mt-3 crm-action-bar">
    <a asp-action="Edit" asp-route-id="@Model?.IdOferty" class="btn btn-primary">Edytuj</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>

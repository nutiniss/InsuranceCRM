@{
    ViewData["Title"] = "Pulpit agenta";
    var klienci = ViewData["Klienci"] ?? 0;
    var polisy = ViewData["Polisy"] ?? 0;
    var oferty = ViewData["Oferty"] ?? 0;
    var zgloszenia = ViewData["Zgloszenia"] ?? 0;
    var zadaniaOtwarte = ViewData["ZadaniaOtwarte"] ?? 0;
    var wiadomosciNieprzeczytane = ViewData["WiadomosciNieprzeczytane"] ?? 0;
}

<section class="agent-dashboard">
    <div class="stats-grid">
        <article class="stat-card stat-card-link" tabindex="0" role="link" aria-label="Przejdź do listy klientów" data-url="@Url.Action("Index", "Klient")">
            <h4>Klienci <i class="bi bi-people"></i></h4>
            <div class="stat-rows two-columns">
                <div><span>Aktywni</span><strong>@klienci</strong></div>
                <div class="stat-action-cell"><a class="btn btn-success stat-action-btn" asp-controller="Klient" asp-action="Create">Dodaj</a></div>
            </div>
        </article>

        <article class="stat-card stat-card-link" tabindex="0" role="link" aria-label="Przejdź do listy polis" data-url="@Url.Action("Index", "Polisa")">
            <h4>Polisy <i class="bi bi-shield-check"></i></h4>
            <div class="stat-rows two-columns">
                <div><span>W portfelu</span><strong>@polisy</strong></div>
                <div class="stat-action-cell"><a class="btn btn-success stat-action-btn" asp-controller="Polisa" asp-action="Create">Dodaj</a></div>
            </div>
        </article>

        <article class="stat-card stat-card-link" tabindex="0" role="link" aria-label="Przejdź do listy ofert" data-url="@Url.Action("Index", "Oferta")">
            <h4>Oferty <i class="bi bi-file-earmark-text"></i></h4>
            <div class="stat-rows two-columns">
                <div><span>Aktywne</span><strong>@oferty</strong></div>
                <div class="stat-action-cell"><a class="btn btn-success stat-action-btn" asp-controller="Oferta" asp-action="Create">Dodaj</a></div>
            </div>
        </article>

        <article class="stat-card">
            <h4>Obsługa <i class="bi bi-headset"></i></h4>
            <div class="stat-rows two-columns">
                <div><span>Zgłoszenia</span><strong>@zgloszenia</strong></div>
                <div><span>Zadania otwarte</span><strong>@zadaniaOtwarte</strong></div>
            </div>
        </article>
    </div>

    <div class="module-grid two-columns mt-4">
        <a class="module-tile" asp-controller="Zadanie" asp-action="Index">
            <span class="module-icon" aria-hidden="true"><i class="bi bi-list-task"></i></span>
            <span class="module-title">Zadania agenta</span>
            <span class="module-description">Priorytety, działania posprzedażowe i kontakty do wykonania.</span>
        </a>

        <a class="module-tile" asp-controller="Wiadomosc" asp-action="Index">
            <span class="module-icon" aria-hidden="true"><i class="bi bi-envelope-paper"></i></span>
            <span class="module-title">Wiadomości</span>
            <span class="module-description">Nieprzeczytane wiadomości: @wiadomosciNieprzeczytane. Przejdź do komunikacji z klientami.</span>
        </a>
    </div>
</section>

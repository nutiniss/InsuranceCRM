@{
    ViewData["Title"] = "Pulpit agenta";
}

<section class="agent-dashboard">
    <div class="news-panel">
        <div class="news-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <h2 class="news-title mb-0">
                <i class="bi bi-newspaper"></i>
                Najnowsze wiadomości
            </h2>
            <a href="#" class="news-link">Zobacz wszystkie <i class="bi bi-chevron-right"></i></a>
        </div>

        <div class="news-list mt-4">
            <article class="news-card">
                <div class="news-date">08.11.2024</div>
                <div class="news-content">
                    <h3 class="news-item-title">Zgłoszenia do ubezpieczenia grupowego dla Agentów Grupy TU i OFWCA oraz ich małżonków i pełnoletnich dzieci</h3>
                    <p class="news-desc mb-0">Przypominamy, że zbliża się termin zgłoszeń do ubezpieczenia grupowego dla Agentów Grupy TU i OFWCA...</p>
                </div>
                <span class="news-badge">NOWE</span>
            </article>

            <article class="news-card">
                <div class="news-date">05.11.2024</div>
                <div class="news-content">
                    <h3 class="news-item-title">Organizacja pracy Centrum Wsparcia AW w dniu 10 listopada</h3>
                    <p class="news-desc mb-0">10 listopada 2025 r. Specjaliści Produktowi w Centrum Wsparcia AW będą dla Was dostępni w godzinach 8:00-16:00...</p>
                </div>
                <span class="news-badge">NOWE</span>
            </article>

            <article class="news-card">
                <div class="news-date">01.11.2024</div>
                <div class="news-content">
                    <h3 class="news-item-title">CRM NEWS: Teraz WIEM! Nowa strona CRM i Feniksa już dostępna w bazie wiedzy</h3>
                    <p class="news-desc mb-0">Zastanawiasz się, gdzie znaleźć wszystko o Feniksie i Kampaniach CRM? Już nie musisz! Na wiem.tu.pl czeka na Ciebie...</p>
                </div>
            </article>
        </div>
    </div>

    <div class="stats-grid mt-4">
        <article class="stat-card">
            <h4>Klienci aktywni z 1 polisą <i class="bi bi-info-circle"></i></h4>
            <div class="stat-rows">
                <div><span>Razem</span><strong>1001</strong></div>
                <div><span>Unijny</span><strong>278</strong></div>
                <div><span>TU SA</span><strong>702</strong></div>
                <div><span>TU Życie</span><strong>21</strong></div>
            </div>
        </article>

        <article class="stat-card">
            <h4>Klienci aktywni - #mojeTU</h4>
            <div class="stat-rows two-columns">
                <div><span>ma konto</span><strong>1259</strong></div>
                <div><span>nie ma konta</span><strong>1231</strong></div>
            </div>
        </article>

        <article class="stat-card">
            <h4>Klienci nieaktywni <i class="bi bi-info-circle"></i></h4>
            <div class="stat-rows">
                <div><span>Razem</span><strong>1065</strong></div>
                <div><span>Unijny</span><strong>478</strong></div>
                <div><span>TU SA</span><strong>585</strong></div>
                <div><span>TU Życie</span><strong>2</strong></div>
            </div>
        </article>

        <article class="stat-card">
            <h4>Nowi klienci aktywni w agencji <i class="bi bi-info-circle"></i></h4>
            <div class="stat-rows">
                <div><span>Razem</span><strong>228</strong></div>
                <div><span>Unijny</span><strong>2</strong></div>
                <div><span>TU SA</span><strong>212</strong></div>
                <div><span>TU Życie</span><strong>14</strong></div>
            </div>
        </article>
    </div>
</section>

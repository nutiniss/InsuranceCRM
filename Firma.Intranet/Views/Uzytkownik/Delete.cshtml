@model Firma.Data.Data.Ubezpieczenia.Uzytkownik

@{
    ViewData["Title"] = "Archiwizuj: Użytkownik";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Użytkownicy</p>
        <h1>Archiwizuj: Użytkownik</h1>
        <p class="crm-muted mb-0">Rekord zostanie oznaczony statusem „Usunięty” i ukryty na liście, bez fizycznego kasowania danych.</p>
    </div>
</div>
<div class="crm-form-card">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Imie)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Imie)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nazwisko)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nazwisko)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Rola)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rola)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CzyAktywny)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CzyAktywny)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdUzytkownika" />
        <input type="submit" value="Archiwizuj" class="btn btn-danger" />
        <a asp-action="Index">Powrót do listy</a>
    </form>
</div>

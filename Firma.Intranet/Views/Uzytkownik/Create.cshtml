@model Firma.Data.Data.Ubezpieczenia.Uzytkownik

@{
    ViewData["Title"] = "Dodaj: Użytkownik";
}

<div class="crm-form-card">
<div class="row g-3">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Imie" class="control-label"></label>
                <input asp-for="Imie" class="form-control" />
                <span asp-validation-for="Imie" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nazwisko" class="control-label"></label>
                <input asp-for="Nazwisko" class="form-control" />
                <span asp-validation-for="Nazwisko" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rola" class="control-label"></label>
                <select asp-for="Rola" class="form-control" asp-items="ViewBag.RoleUzytkownika">
                    <option value="">-- wybierz rolę --</option>
                </select>
                <span asp-validation-for="Rola" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CzyAktywny" /> @Html.DisplayNameFor(model => model.CzyAktywny)
                </label>
            </div>
            <div class="mb-3">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model LoginViewModel
@{
    ViewData["Title"] = "Logowanie";
    Layout = "_Layout";
}

<section class="login-page">
    <div class="login-card">
        <div class="login-brand text-center mb-4">
            <img src="~/content/logoIntranet.png" alt="Logo Twoje ubezpieczenia" />
            <h1>Panel pracownika</h1>
            <p>Zaloguj się, aby przejść do modułów CRM.</p>
        </div>

        <form asp-action="Login" method="post" class="d-flex flex-column gap-3">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="np. agent@firma.pl" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Hasło demonstracyjne: admin" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success btn-lg w-100">Zaloguj</button>
            <p class="login-hint mb-0">Wersja edukacyjna: konto musi istnieć w tabeli użytkowników, a hasło demonstracyjne to <strong>admin</strong>.</p>
        </form>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Twoje ubezpieczenia</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="agent-topbar border-bottom">
            <div class="container-fluid px-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                <a class="brand-section text-decoration-none text-dark" asp-area="" asp-controller="Home" asp-action="Pulpit">
                    <img src="~/content/logoIntranet.png" alt="Logo Twoje ubezpieczenia" class="brand-logo" />
                    <span class="brand-title">Twoje ubezpieczenia</span>
                </a>

                <div class="user-menu d-flex align-items-center flex-wrap gap-3">
                    <a href="#" class="text-decoration-none top-link d-flex align-items-center gap-2">
                        <span class="position-relative d-inline-block">
                            <span class="icon-circle" aria-hidden="true"><i class="bi bi-bell"></i></span>
                            <span class="badge rounded-pill bg-danger notification-badge">5</span>
                        </span>
                        <span>Powiadomienia</span>
                    </a>
                    <span class="divider"></span>
                    <span class="d-flex align-items-center gap-2 text-secondary">
                        <span class="icon-circle" aria-hidden="true"><i class="bi bi-person"></i></span>
                        <span class="username">Jan Kowalski</span>
                    </span>
                    <a href="#" class="btn btn-outline-success btn-sm px-3">WYLOGUJ</a>
                </div>
            </div>
        </div>

        <nav class="agent-navbar border-bottom">
            <div class="container-fluid px-4">
                @{ var currentAction = ViewContext.RouteData.Values["action"]?.ToString(); }
                <ul class="nav nav-tabs border-0 gap-2">
                    <li class="nav-item"><a class="nav-link @(currentAction == "Pulpit" ? "active" : "")" asp-controller="Home" asp-action="Pulpit">Pulpit</a></li>
                    <li class="nav-item"><a class="nav-link @(currentAction == "Obsluga" ? "active" : "")" asp-controller="Home" asp-action="Obsluga">Obsługa</a></li>
                    <li class="nav-item"><a class="nav-link @(currentAction == "Wiadomosci" ? "active" : "")" asp-controller="Wiadomosc" asp-action="Index">Wiadomości</a></li>
                    <li class="nav-item"><a class="nav-link @(currentAction == "Polisy" ? "active" : "")" asp-controller="Home" asp-action="Polisy">Polisy</a></li>
                    <li class="nav-item"><a class="nav-link @(currentAction == "Oferty" ? "active" : "")" asp-controller="Oferta" asp-action="Index">Oferty</a></li>
                    <li class="nav-item"><a class="nav-link @(currentAction == "Administracja" ? "active" : "")" asp-controller="Home" asp-action="Administracja">Administracja</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content container-fluid px-4 py-4">
        @RenderBody()
    </main>

    <footer class="agent-footer mt-auto">
        <div class="container-fluid px-4 d-flex flex-wrap gap-3 align-items-center">
            <span>© 2026 Twoje ubezpieczenia</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Polityka prywatności</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model IEnumerable<Firma.Data.Data.CMS.TekstPortalu>
@{
    ViewData["Title"] = "Teksty portalu";
}
<div class="crm-table-card">
    <div class="table-responsive">
        <table class="table crm-table align-middle mb-0">
            <thead><tr><th>Klucz</th><th>Tytuł</th><th>Treść</th><th>Kolejność</th><th>Aktywny</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.Klucz</code></td>
                    <td>@item.Tytul</td>
                    <td>@item.Tresc</td>
                    <td>@item.Kolejnosc</td>
                    <td>@Html.DisplayFor(_ => item.CzyAktywny)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IdTekstuPortalu">Edytuj</a>
                        <a asp-action="Details" asp-route-id="@item.IdTekstuPortalu">Szczegóły</a>
                        <a asp-action="Delete" asp-route-id="@item.IdTekstuPortalu">Archiwizuj</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3"><a asp-action="Create" class="btn btn-success crm-primary-action"><i class="bi bi-plus-circle"></i> Dodaj</a></div>

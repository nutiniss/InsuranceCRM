@model Firma.Data.Data.CMS.TekstPortalu
@{
    ViewData["Title"] = "Archiwizuj tekst portalu";
}
<div class="alert alert-warning">Czy na pewno chcesz zarchiwizować tekst <strong>@Model.Klucz</strong>? Portal zacznie używać wartości domyślnej z kodu.</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="IdTekstuPortalu" />
    <input type="submit" value="Archiwizuj" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</form>

@model Firma.Data.Data.CMS.TekstPortalu

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="IdTekstuPortalu" />
<input type="hidden" asp-for="DataUtworzenia" />
<input type="hidden" asp-for="DataModyfikacji" />
<input type="hidden" asp-for="StatusRekordu" />
<div class="mb-3">
    <label asp-for="Klucz" class="control-label"></label>
    <input asp-for="Klucz" class="form-control" placeholder="np. portal.start.hero" />
    <span asp-validation-for="Klucz" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Tytul" class="control-label"></label>
    <input asp-for="Tytul" class="form-control" />
    <span asp-validation-for="Tytul" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Tresc" class="control-label"></label>
    <textarea asp-for="Tresc" class="form-control" rows="6"></textarea>
    <span asp-validation-for="Tresc" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Kolejnosc" class="control-label"></label>
    <input asp-for="Kolejnosc" class="form-control" />
    <span asp-validation-for="Kolejnosc" class="text-danger"></span>
</div>
<div class="form-group form-check mb-3">
    <label class="form-check-label">
        <input class="form-check-input" asp-for="CzyAktywny" /> @Html.DisplayNameFor(model => model.CzyAktywny)
    </label>
</div>

@model IEnumerable<Firma.Data.Data.Ubezpieczenia.Wiadomosc>

@{
    ViewData["Title"] = "Wiadomości";
}


<div class="crm-table-card">
    <div class="table-responsive">
<table class="table crm-table align-middle mb-0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Temat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tresc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Typ)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataUtworzenia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataWyslania)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CzyPrzeczytana)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Klient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Uzytkownik)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Temat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tresc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Typ)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataUtworzenia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataWyslania)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CzyPrzeczytana)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Klient.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Uzytkownik.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdWiadomosci">Edytuj</a>
                <a asp-action="Details" asp-route-id="@item.IdWiadomosci">Szczegóły</a>
                <a asp-action="Delete" asp-route-id="@item.IdWiadomosci">Archiwizuj</a>
            </td>
        </tr>
}
    </tbody>
</table>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Create" class="btn btn-success crm-primary-action"><i class="bi bi-plus-circle"></i> Dodaj</a>
</div>
@model Firma.Data.Data.Ubezpieczenia.Wiadomosc

@{
    ViewData["Title"] = "Dodaj: Wiadomość";
}

<div class="crm-form-card">
<div class="row g-3">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Temat" class="control-label"></label>
                <input asp-for="Temat" class="form-control" />
                <span asp-validation-for="Temat" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tresc" class="control-label"></label>
                <input asp-for="Tresc" class="form-control" />
                <span asp-validation-for="Tresc" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Typ" class="control-label"></label>
                <select asp-for="Typ" class="form-control" asp-items="ViewBag.TypyWiadomosci">
                    <option value="">-- wybierz typ wiadomości --</option>
                </select>
                <span asp-validation-for="Typ" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataUtworzenia" class="control-label"></label>
                <input asp-for="DataUtworzenia" class="form-control" />
                <span asp-validation-for="DataUtworzenia" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataWyslania" class="control-label"></label>
                <input asp-for="DataWyslania" class="form-control" />
                <span asp-validation-for="DataWyslania" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CzyPrzeczytana" /> @Html.DisplayNameFor(model => model.CzyPrzeczytana)
                </label>
            </div>
            <div class="mb-3">
                <label asp-for="IdKlienta" class="control-label"></label>
                <select asp-for="IdKlienta" class ="form-control" asp-items="ViewBag.IdKlienta"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdUzytkownika" class="control-label"></label>
                <select asp-for="IdUzytkownika" class ="form-control" asp-items="ViewBag.IdUzytkownika"></select>
            </div>
            <div class="mb-3">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model Firma.Data.Data.Ubezpieczenia.Wiadomosc

@{
    ViewData["Title"] = "Archiwizuj: Wiadomość";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Wiadomości</p>
        <h1>Archiwizuj: Wiadomość</h1>
        <p class="crm-muted mb-0">Rekord zostanie oznaczony statusem „Usunięty” i ukryty na liście, bez fizycznego kasowania danych.</p>
    </div>
</div>
<div class="crm-form-card">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Temat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Temat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tresc)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tresc)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Typ)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Typ)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataUtworzenia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataUtworzenia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataWyslania)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataWyslania)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CzyPrzeczytana)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CzyPrzeczytana)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Klient)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Klient.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Uzytkownik)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Uzytkownik.Email)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdWiadomosci" />
        <input type="submit" value="Archiwizuj" class="btn btn-danger" />
        <a asp-action="Index">Powrót do listy</a>
    </form>
</div>

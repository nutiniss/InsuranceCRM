@model Firma.Data.Data.Ubezpieczenia.Wiadomosc

@{
    ViewData["Title"] = "Szczegóły: Wiadomość";
}

<div class="crm-form-card">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Temat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Temat)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tresc)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tresc)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Typ)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Typ)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataUtworzenia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataUtworzenia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataWyslania)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataWyslania)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CzyPrzeczytana)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CzyPrzeczytana)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Klient)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Klient.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Uzytkownik)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Uzytkownik.Email)
        </dd>
    </dl>
</div>

@if (TempData["MessageSuccess"] is string success)
{
    <div class="alert alert-success mt-3" role="alert">@success</div>
}
@if (TempData["MessageError"] is string error)
{
    <div class="alert alert-danger mt-3" role="alert">@error</div>
}

<div class="crm-form-card mt-3">
    <h2 class="h5 mb-3">Odpowiedz klientowi</h2>
    <form asp-action="Reply" asp-route-id="@Model.IdWiadomosci" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label for="tresc" class="form-label">Treść odpowiedzi</label>
            <textarea id="tresc" name="tresc" class="form-control" rows="5" placeholder="Wpisz odpowiedź widoczną w portalu klienta"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Wyślij odpowiedź</button>
    </form>
</div>

<div class="d-flex gap-2 mt-3 crm-action-bar">
    <a asp-action="Edit" asp-route-id="@Model?.IdWiadomosci" class="btn btn-primary">Edytuj</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</div>

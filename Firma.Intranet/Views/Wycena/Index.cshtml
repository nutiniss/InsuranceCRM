@model IEnumerable<Firma.Data.Data.Ubezpieczenia.Wycena>

@{
    ViewData["Title"] = "Wyceny";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Portal CRM</p>
        <h1>Wyceny</h1>
        <p class="crm-muted mb-0">Przegląd aktywnych rekordów i szybkie akcje operacyjne.</p>
    </div>
    <a asp-action="Create" class="btn btn-success crm-primary-action"><i class="bi bi-plus-circle"></i> Dodaj</a>
</div>
<div class="crm-table-card">
    <div class="table-responsive">
<table class="table crm-table align-middle mb-0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DataWyceny)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MetodaWyceny)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WartoscPrzedmiotuUbezpieczenia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SumaUbezpieczenia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Skladka)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Uwagi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Oferta)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DataWyceny)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MetodaWyceny)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WartoscPrzedmiotuUbezpieczenia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SumaUbezpieczenia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Skladka)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Uwagi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Oferta.NumerOferty)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdWyceny">Edytuj</a>
                <a asp-action="Details" asp-route-id="@item.IdWyceny">Szczegóły</a>
                <a asp-action="Delete" asp-route-id="@item.IdWyceny">Archiwizuj</a>
            </td>
        </tr>
}
    </tbody>
</table>
    </div>
</div>

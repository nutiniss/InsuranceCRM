@model IEnumerable<Firma.Data.Data.Ubezpieczenia.Polisa>

@{
    ViewData["Title"] = "Polisy";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Portal CRM</p>
        <h1>Polisy</h1>
        <p class="crm-muted mb-0">Przegląd aktywnych rekordów i szybkie akcje operacyjne.</p>
    </div>
    <a asp-action="Create" class="btn btn-success crm-primary-action"><i class="bi bi-plus-circle"></i> Dodaj</a>
</div>
<div class="crm-table-card">
    <div class="table-responsive">
<table class="table crm-table align-middle mb-0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NumerPolisy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PoczatekOchrony)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KoniecOchrony)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Skladka)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Klient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Uzytkownik)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProduktUbezpieczeniowy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Oferta)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NumerPolisy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PoczatekOchrony)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KoniecOchrony)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Skladka)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Klient.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Uzytkownik.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProduktUbezpieczeniowy.Kategoria)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Oferta.NumerOferty)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdPolisy">Edytuj</a>
                <a asp-action="Details" asp-route-id="@item.IdPolisy">Szczegóły</a>
                <a asp-action="Delete" asp-route-id="@item.IdPolisy">Archiwizuj</a>
            </td>
        </tr>
}
    </tbody>
</table>
    </div>
</div>

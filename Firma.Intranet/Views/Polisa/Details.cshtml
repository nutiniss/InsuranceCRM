@model Firma.Data.Data.Ubezpieczenia.Polisa

@{
    ViewData["Title"] = "Szczegóły: Polisa";
}

<div class="crm-form-card">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NumerPolisy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumerPolisy)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PoczatekOchrony)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PoczatekOchrony)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.KoniecOchrony)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.KoniecOchrony)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Skladka)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Skladka)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Klient)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Klient.Email)

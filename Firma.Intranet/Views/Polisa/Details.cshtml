<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.IdPolisy" class="btn btn-primary">Edytuj</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</div>

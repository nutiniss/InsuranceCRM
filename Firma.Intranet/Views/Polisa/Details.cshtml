        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.KoniecOchrony)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Skladka)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Skladka)
        </dd>
        <dt class = "col-sm-2">

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ProduktUbezpieczeniowy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ProduktUbezpieczeniowy.Kategoria)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Oferta)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Oferta.NumerOferty)
        </dd>

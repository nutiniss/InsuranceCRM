@model Firma.Data.Data.Ubezpieczenia.Polisa

@{
    ViewData["Title"] = "Dodaj: Polisa";
}

<div class="crm-form-card">
<div class="row g-3">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NumerPolisy" class="control-label"></label>
                <input asp-for="NumerPolisy" class="form-control" />
                <span asp-validation-for="NumerPolisy" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PoczatekOchrony" class="control-label"></label>
                <input asp-for="PoczatekOchrony" class="form-control" />
                <span asp-validation-for="PoczatekOchrony" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="KoniecOchrony" class="control-label"></label>
                <input asp-for="KoniecOchrony" class="form-control" />
                <span asp-validation-for="KoniecOchrony" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Skladka" class="control-label"></label>
                <input asp-for="Skladka" class="form-control" />
                <span asp-validation-for="Skladka" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="ViewBag.StatusyPolisy">
                    <option value="">-- wybierz status polisy --</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IdKlienta" class="control-label"></label>
                <select asp-for="IdKlienta" class ="form-control" asp-items="ViewBag.IdKlienta"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdUzytkownika" class="control-label"></label>
                <select asp-for="IdUzytkownika" class ="form-control" asp-items="ViewBag.IdUzytkownika"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdProduktuUbezpieczeniowego" class="control-label"></label>
                <select asp-for="IdProduktuUbezpieczeniowego" class ="form-control" asp-items="ViewBag.IdProduktuUbezpieczeniowego"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdOferty" class="control-label"></label>
                <select asp-for="IdOferty" class ="form-control" asp-items="ViewBag.IdOferty"></select>
            </div>
            <div class="mb-3">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

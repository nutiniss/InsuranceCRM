        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Polisa.NumerPolisy)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdZadania">Edytuj</a>
    <a asp-action="Index">Powrót do listy</a>
</div>

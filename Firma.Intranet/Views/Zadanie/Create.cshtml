@model Firma.Data.Data.Ubezpieczenia.Zadanie

@{
    ViewData["Title"] = "Dodaj: Zadanie";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Zadania</p>
        <h1>Dodaj: Zadanie</h1>
        <p class="crm-muted mb-0">Uzupełnij dane wymagane do obsługi procesu w CRM.</p>
    </div>
</div>
<div class="crm-form-card">
<div class="row g-3">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Nazwa" class="control-label"></label>
                <input asp-for="Nazwa" class="form-control" />
                <span asp-validation-for="Nazwa" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Opis" class="control-label"></label>
                <input asp-for="Opis" class="form-control" />
                <span asp-validation-for="Opis" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Typ" class="control-label"></label>
                <select asp-for="Typ" class="form-control" asp-items="ViewBag.TypyZadania">
                    <option value="">-- wybierz typ zadania --</option>
                </select>
                <span asp-validation-for="Typ" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="ViewBag.StatusyZadania">
                    <option value="">-- wybierz status zadania --</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataUtworzenia" class="control-label"></label>
                <input asp-for="DataUtworzenia" class="form-control" />
                <span asp-validation-for="DataUtworzenia" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataRealizacji" class="control-label"></label>
                <input asp-for="DataRealizacji" class="form-control" />
                <span asp-validation-for="DataRealizacji" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IdKlienta" class="control-label"></label>
                <select asp-for="IdKlienta" class ="form-control" asp-items="ViewBag.IdKlienta"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdUzytkownika" class="control-label"></label>
                <select asp-for="IdUzytkownika" class ="form-control" asp-items="ViewBag.IdUzytkownika"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdZgloszenia" class="control-label"></label>
                <select asp-for="IdZgloszenia" class ="form-control" asp-items="ViewBag.IdZgloszenia"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdOferty" class="control-label"></label>
                <select asp-for="IdOferty" class ="form-control" asp-items="ViewBag.IdOferty"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IdPolisy" class="control-label"></label>
                <select asp-for="IdPolisy" class ="form-control" asp-items="ViewBag.IdPolisy"></select>
            </div>
            <div class="mb-3">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

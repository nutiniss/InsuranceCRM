@model Firma.Data.Data.Ubezpieczenia.Zadanie

@{
    ViewData["Title"] = "Archiwizuj: Zadanie";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Zadania</p>
        <h1>Archiwizuj: Zadanie</h1>
        <p class="crm-muted mb-0">Rekord zostanie oznaczony statusem „Usunięty” i ukryty na liście, bez fizycznego kasowania danych.</p>
    </div>
</div>
<div class="crm-form-card">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nazwa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nazwa)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Opis)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Opis)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Typ)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Typ)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataUtworzenia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataUtworzenia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataRealizacji)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataRealizacji)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Klient)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Klient.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Uzytkownik)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Uzytkownik.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Zgloszenie)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Zgloszenie.NumerZgloszenia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Oferta)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Oferta.NumerOferty)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Polisa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Polisa.NumerPolisy)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdZadania" />
        <input type="submit" value="Archiwizuj" class="btn btn-danger" />
        <a asp-action="Index">Powrót do listy</a>
    </form>
</div>

@model Firma.Data.Data.Ubezpieczenia.ProduktUbezpieczeniowy

@{
    ViewData["Title"] = "Szczegóły: Produkt ubezpieczeniowy";
}

<div class="crm-form-card">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Kod)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nazwa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nazwa)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kategoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Kategoria)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Opis)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Opis)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CzyAktywny)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CzyAktywny)
        </dd>
    </dl>
</div>
<div class="d-flex gap-2 mt-3 crm-action-bar">
    <a asp-action="Edit" asp-route-id="@Model?.IdProduktuUbezpieczeniowego" class="btn btn-primary">Edytuj</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</div>

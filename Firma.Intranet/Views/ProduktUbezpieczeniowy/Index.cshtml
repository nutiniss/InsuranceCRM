@model IEnumerable<Firma.Data.Data.Ubezpieczenia.ProduktUbezpieczeniowy>

@{
    ViewData["Title"] = "Produkty ubezpieczeniowe";
}

<div class="crm-page-heading">
    <div>
        <p class="crm-eyebrow">Portal CRM</p>
        <h1>Produkty ubezpieczeniowe</h1>
        <p class="crm-muted mb-0">Przegląd aktywnych rekordów i szybkie akcje operacyjne.</p>
    </div>
    <a asp-action="Create" class="btn btn-success crm-primary-action"><i class="bi bi-plus-circle"></i> Dodaj</a>
</div>
<div class="crm-table-card">
    <div class="table-responsive">
<table class="table crm-table align-middle mb-0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Kod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nazwa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kategoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CzyAktywny)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Kod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nazwa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kategoria)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Opis)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CzyAktywny)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdProduktuUbezpieczeniowego">Edytuj</a>
                <a asp-action="Details" asp-route-id="@item.IdProduktuUbezpieczeniowego">Szczegóły</a>
                <a asp-action="Delete" asp-route-id="@item.IdProduktuUbezpieczeniowego">Archiwizuj</a>
            </td>
        </tr>
}
    </tbody>
</table>
    </div>
</div>

@model Firma.Data.Data.CMS.StronaPortalu
@{
    ViewData["Title"] = "Dodaj stronę portalu";
}
<div class="crm-form-card">
    <div class="row g-3">
        <div class="col-lg-8 col-xl-7">
            <form asp-action="Create">
                <partial name="_Form" model="Model" />
                <div class="mb-3"><input type="submit" value="Dodaj" class="btn btn-primary" /></div>
            </form>
        </div>
    </div>
</div>
<div class="d-flex gap-2 mt-3"><a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }

@model Firma.Data.Data.CMS.StronaPortalu
@{
    ViewData["Title"] = "Szczegóły strony portalu";
}
<div class="crm-form-card">
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TytulMenu)</dt><dd class="col-sm-9">@Html.DisplayFor(model => model.TytulMenu)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Slug)</dt><dd class="col-sm-9"><code>@Model.Slug</code></dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tytul)</dt><dd class="col-sm-9">@Html.DisplayFor(model => model.Tytul)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NaglowekPomocniczy)</dt><dd class="col-sm-9">@Html.DisplayFor(model => model.NaglowekPomocniczy)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tresc)</dt><dd class="col-sm-9">@Html.DisplayFor(model => model.Tresc)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CzyWidocznaWMenu)</dt><dd class="col-sm-9">@Html.DisplayFor(model => model.CzyWidocznaWMenu)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CzyAktywna)</dt><dd class="col-sm-9">@Html.DisplayFor(model => model.CzyAktywna)</dd>
    </dl>
</div>
<div class="d-flex gap-2 mt-3"><a asp-action="Edit" asp-route-id="@Model.IdStronyPortalu" class="btn btn-primary">Edytuj</a><a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a></div>

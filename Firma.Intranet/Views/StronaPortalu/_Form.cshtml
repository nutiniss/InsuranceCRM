@model Firma.Data.Data.CMS.StronaPortalu

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="IdStronyPortalu" />
<input type="hidden" asp-for="DataUtworzenia" />
<input type="hidden" asp-for="DataModyfikacji" />
<input type="hidden" asp-for="StatusRekordu" />
<div class="mb-3">
    <label asp-for="Slug" class="control-label"></label>
    <input asp-for="Slug" class="form-control" placeholder="np. jak-zglosic-szkode" />
    <span asp-validation-for="Slug" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="TytulMenu" class="control-label"></label>
    <input asp-for="TytulMenu" class="form-control" />
    <span asp-validation-for="TytulMenu" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Tytul" class="control-label"></label>
    <input asp-for="Tytul" class="form-control" />
    <span asp-validation-for="Tytul" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="NaglowekPomocniczy" class="control-label"></label>
    <input asp-for="NaglowekPomocniczy" class="form-control" />
    <span asp-validation-for="NaglowekPomocniczy" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Tresc" class="control-label"></label>
    <textarea asp-for="Tresc" class="form-control" rows="8"></textarea>
    <span asp-validation-for="Tresc" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Kolejnosc" class="control-label"></label>
    <input asp-for="Kolejnosc" class="form-control" />
    <span asp-validation-for="Kolejnosc" class="text-danger"></span>
</div>
<div class="form-group form-check mb-2">
    <label class="form-check-label">
        <input class="form-check-input" asp-for="CzyWidocznaWMenu" /> @Html.DisplayNameFor(model => model.CzyWidocznaWMenu)
    </label>
</div>
<div class="form-group form-check mb-3">
    <label class="form-check-label">
        <input class="form-check-input" asp-for="CzyAktywna" /> @Html.DisplayNameFor(model => model.CzyAktywna)
    </label>
</div>

@model Firma.PortalWWW.Models.ClientPortalMessagesViewModel

@{
    ViewData["Title"] = Model.Title;
    var nieprzeczytane = Model.Items.Count(wiadomosc => !wiadomosc.CzyPrzeczytana && wiadomosc.Typ != "Wiadomość klienta");
}

<section class="hero-panel client-page-hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="hero-eyebrow">@Model.Eyebrow</span>
            <h1 class="hero-title">@Model.Title</h1>
            <p class="hero-lead">@Model.Description</p>
        </div>
        <div class="col-lg-4">
            <div class="hero-summary-card">
                <span class="summary-label">@Model.SummaryLabel</span>
                <span class="summary-value">@nieprzeczytane</span>
                <span class="summary-caption">@Model.SummaryCaption</span>
            </div>
        </div>
    </div>
</section>

<section class="client-panel">
    <div class="client-panel-header">
        <div>
            <h2 class="section-title">Skrzynka wiadomości</h2>
        </div>
    </div>


    @if (TempData["PortalSuccess"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["PortalError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="client-form-card mb-4">
        <h3 class="h5 mb-3">Napisz do agenta</h3>
        <form asp-action="WyslijWiadomosc" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label asp-for="NewMessage.IdUzytkownika" class="form-label"></label>
                <select asp-for="NewMessage.IdUzytkownika" class="form-select" name="IdUzytkownika">
                    @foreach (var agent in Model.Agents)
                    {
                        <option value="@agent.IdUzytkownika">@agent.Imie @agent.Nazwisko</option>
                    }
                </select>
            </div>
            <div class="col-md-8">
                <label asp-for="NewMessage.Temat" class="form-label"></label>
                <input asp-for="NewMessage.Temat" class="form-control" name="Temat" placeholder="Np. Pytanie o odnowienie polisy" />
            </div>
            <div class="col-12">
                <label asp-for="NewMessage.Tresc" class="form-label"></label>
                <textarea asp-for="NewMessage.Tresc" class="form-control" name="Tresc" rows="4" placeholder="Opisz sprawę, którą chcesz przekazać agentowi"></textarea>
            </div>
            <div class="col-12 text-end">
                <button class="btn btn-primary" type="submit"><i class="bi bi-send"></i> Wyślij wiadomość</button>
            </div>
        </form>
    </div>

    @if (Model.Items.Any())
    {
        <div class="message-list">
            @foreach (var wiadomosc in Model.Items)
            {
                var wymagaOdczytania = !wiadomosc.CzyPrzeczytana && wiadomosc.Typ != "Wiadomość klienta";
                <article class="message-item @(wymagaOdczytania ? "unread" : string.Empty)">
                    <div class="message-icon" aria-hidden="true"><i class="bi bi-envelope-paper"></i></div>
                    <div class="message-content">
                        <div class="record-card-header mb-2">
                            <div>
                                <span class="record-number">@wiadomosc.Typ</span>
                                <h3>@wiadomosc.Temat</h3>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="status-pill">@(wymagaOdczytania ? "Nowa" : "Przeczytana")</span>
                                @if (wymagaOdczytania)
                                {
                                    <form asp-action="OznaczWiadomoscJakoPrzeczytana" asp-route-id="@wiadomosc.IdWiadomosci" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-outline-primary btn-sm" type="submit">Oznacz jako przeczytaną</button>
                                    </form>
                                }
                            </div>
                        </div>
                        <p class="record-description">@wiadomosc.Tresc</p>
                        <div class="record-meta-grid compact">
                            <div><span>Data</span><strong>@((wiadomosc.DataWyslania ?? wiadomosc.DataUtworzenia).ToString("dd.MM.yyyy HH:mm"))</strong></div>
                            <div><span>Nadawca</span><strong>@(wiadomosc.Uzytkownik is null ? "Centrum obsługi" : $"{wiadomosc.Uzytkownik.Imie} {wiadomosc.Uzytkownik.Nazwisko}")</strong></div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-offers-state text-center p-5">
            <i class="bi bi-envelope empty-offers-icon" aria-hidden="true"></i>
            <h3>Brak wiadomości</h3>
            <p class="mb-0">Nowe komunikaty od opiekuna i powiadomienia systemowe będą widoczne w tej skrzynce.</p>
        </div>
    }
</section>

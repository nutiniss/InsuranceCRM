@{
    ViewData["Title"] = "Polityka prywatności";
}

<section class="hero-panel client-page-hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="hero-eyebrow">Bezpieczeństwo danych</span>
            <h1 class="hero-title">Polityka prywatności</h1>
            <p class="hero-lead">Zasady przetwarzania danych w portalu klienta oraz informacje o ochronie komunikacji ubezpieczeniowej.</p>
        </div>
        <div class="col-lg-4">
            <div class="hero-summary-card">
                <span class="summary-label">Portal klienta</span>
                <span class="summary-value"><i class="bi bi-shield-lock"></i></span>
                <span class="summary-caption">bezpieczna obsługa online</span>
            </div>
        </div>
    </div>
</section>

<section class="client-panel privacy-panel">
    <h2 class="section-title">Najważniejsze informacje</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <article class="privacy-card">
                <i class="bi bi-person-check" aria-hidden="true"></i>
                <h3>Dane klienta</h3>
                <p>Wykorzystujemy dane identyfikacyjne i kontaktowe wyłącznie do obsługi polis, ofert, zgłoszeń oraz komunikacji z opiekunem.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="privacy-card">
                <i class="bi bi-envelope-lock" aria-hidden="true"></i>
                <h3>Komunikacja</h3>
                <p>Wiadomości i powiadomienia w portalu służą do przekazywania informacji związanych z zawartymi lub proponowanymi ubezpieczeniami.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="privacy-card">
                <i class="bi bi-database-lock" aria-hidden="true"></i>
                <h3>Ochrona informacji</h3>
                <p>Dostęp do danych jest ograniczony do uprawnionych użytkowników odpowiedzialnych za obsługę klienta i administrację systemem.</p>
            </article>
        </div>
    </div>
</section>

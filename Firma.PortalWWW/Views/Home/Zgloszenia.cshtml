@model Firma.PortalWWW.Models.ClientPortalClaimsViewModel

@{
    ViewData["Title"] = Model.Title;
    var otwarte = Model.Items.Count(zgloszenie => !string.Equals(zgloszenie.Status, "Zamknięte", StringComparison.OrdinalIgnoreCase));
}

<section class="hero-panel client-page-hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="hero-eyebrow">@Model.Eyebrow</span>
            <h1 class="hero-title">@Model.Title</h1>
            <p class="hero-lead">@Model.Description</p>
        </div>
        <div class="col-lg-4">
            <div class="hero-summary-card">
                <span class="summary-label">@Model.SummaryLabel</span>
                <span class="summary-value">@otwarte</span>
                <span class="summary-caption">@Model.SummaryCaption</span>
            </div>
        </div>
    </div>
</section>

<section class="client-panel">
    <div class="client-panel-header">
        <div>
            <h2 class="section-title">Lista zgłoszeń</h2>
        </div>
        
    </div>


    @if (TempData["PortalSuccess"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["PortalError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="client-form-card mb-4">
        <h3 class="h5 mb-3">Nowe zgłoszenie</h3>
        <form asp-action="UtworzZgloszenie" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label asp-for="NewClaim.Tytul" class="form-label"></label>
                <input asp-for="NewClaim.Tytul" class="form-control" name="Tytul" placeholder="Np. Szkoda komunikacyjna" />
            </div>
            <div class="col-md-3">
                <label asp-for="NewClaim.Typ" class="form-label"></label>
                <select asp-for="NewClaim.Typ" class="form-select" name="Typ">
                    <option>Szkoda</option>
                    <option>Zmiana danych</option>
                    <option>Pytanie o polisę</option>
                    <option>Reklamacja</option>
                    <option>Prośba o kontakt</option>
                    <option>Inne</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Opiekun</label>
                <input class="form-control" value="@(Model.Agents.FirstOrDefault() is null ? "Automatyczne przypisanie" : $"{Model.Agents.First().Imie} {Model.Agents.First().Nazwisko}")" disabled />
            </div>
            <div class="col-12">
                <label asp-for="NewClaim.Opis" class="form-label"></label>
                <textarea asp-for="NewClaim.Opis" class="form-control" name="Opis" rows="4" placeholder="Opisz zdarzenie lub sprawę"></textarea>
            </div>
            <div class="col-12 text-end">
                <button class="btn btn-primary" type="submit"><i class="bi bi-plus-circle"></i> Utwórz zgłoszenie</button>
            </div>
        </form>
    </div>

    @if (Model.Items.Any())
    {
        <div class="row g-4">
            @foreach (var zgloszenie in Model.Items)
            {
                <div class="col-12 col-lg-6">
                    <article class="client-record-card h-100">
                        <div class="record-card-header">
                            <div>
                                <span class="record-number">@zgloszenie.NumerZgloszenia</span>
                                <h3>@zgloszenie.Tytul</h3>
                            </div>
                            <span class="status-pill">@zgloszenie.Status</span>
                        </div>
                        <p class="record-description">@zgloszenie.Opis</p>
                        <div class="record-meta-grid">
                            <div><span>Typ</span><strong>@zgloszenie.Typ</strong></div>
                            <div><span>Utworzono</span><strong>@zgloszenie.DataUtworzenia.ToString("dd.MM.yyyy")</strong></div>
                            <div><span>Opiekun</span><strong>@(zgloszenie.Uzytkownik is null ? "W trakcie przypisania" : $"{zgloszenie.Uzytkownik.Imie} {zgloszenie.Uzytkownik.Nazwisko}")</strong></div>
                            <div><span>Zamknięcie</span><strong>@(zgloszenie.DataZamkniecia?.ToString("dd.MM.yyyy") ?? "—")</strong></div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-offers-state text-center p-5">
            <i class="bi bi-headset empty-offers-icon" aria-hidden="true"></i>
            <h3>Brak zgłoszeń</h3>
            <p class="mb-0">Po utworzeniu zgłoszenia jego status i historia obsługi pojawią się w tym miejscu.</p>
        </div>
    }
</section>
